{
  "name": "pi-living-memory",
  "version": "0.3.0",
  "description": "Pi extension: durable long-term memory with lifecycle metadata — entries with kind/status/scope/expiry, TODO + SUMMARY docs, derived indexes, and a read-only archive fallback",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/robert-zz/pi-living-memory.git"
  },
  "homepage": "https://github.com/robert-zz/pi-living-memory#readme",
  "bugs": {
    "url": "https://github.com/robert-zz/pi-living-memory/issues"
  },
  "author": {
    "name": "robert",
    "email": "npm@keqiz.com"
  },
  "keywords": [
    "pi-package",
    "memory",
    "assistant",
    "long-term-memory",
    "agent-memory",
    "context-management",
    "llm"
  ],
  "license": "MIT",
  "type": "module",
  "pi": {
    "extensions": [
      "./extensions/living-memory.ts"
    ],
    "changelogPath": "./CHANGELOG.md",
    "image": "./docs/img/01-architecture-ai.webp"
  },
  "files": [
    "extensions",
    "tests",
    "!tests/under-test",
    "docs",
    "!docs/img/*.gif",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "bun tests/run.ts",
    "test:list": "bun tests/run.ts --list",
    "prepublishOnly": "bun tests/run.ts && bun run typecheck",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "^1.6.0",
    "@earendil-works/pi-coding-agent": "^1.6.0",
    "@types/bun": "^1.4.5",
    "typebox": "^1.3.27",
    "typescript": "^5.9.3"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-ai": {
      "optional": true
    },
    "@earendil-works/pi-coding-agent": {
      "optional": true
    },
    "typebox": {
      "optional": true
    }
  }
}
